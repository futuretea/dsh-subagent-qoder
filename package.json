{
  "name": "dsh-subagent-qoder",
  "version": "0.1.0",
  "description": "One-shot Qoder subagent provider for DeepSeek Harness over the official Qoder Agent SDK",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.0.1-rc.1 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.1.0 <5.0.0",
    "@deepseek-ai/dsh-llm": ">=0.0.1-rc.1 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.0.1-rc.1 <0.3.0",
    "@deepseek-ai/dsh-subagent": ">=0.0.1-rc.1 <0.3.0",
    "@deepseek-ai/dsh-subprocess": ">=0.0.1-rc.1 <0.3.0",
    "@deepseek-ai/dsh-timeout": ">=0.0.1-rc.1 <0.3.0",
    "@deepseek-ai/dsh-tool-subagent": ">=0.0.1-rc.1 <0.3.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0",
    "@qoder-ai/qoder-agent-sdk": "^1.0.59"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-brand": "link:../deepseek-harness/packages/util/brand",
    "@deepseek-ai/dsh-llm": "link:../deepseek-harness/packages/llm/llm",
    "@deepseek-ai/dsh-session": "link:../deepseek-harness/packages/core/session",
    "@deepseek-ai/dsh-subagent": "link:../deepseek-harness/packages/subagent/subagent",
    "@deepseek-ai/dsh-subprocess": "link:../deepseek-harness/packages/subprocess/subprocess",
    "@deepseek-ai/dsh-timeout": "link:../deepseek-harness/packages/util/timeout",
    "@deepseek-ai/dsh-tool-subagent": "link:../deepseek-harness/packages/subagent/tool-subagent",
    "@types/node": "^22.20.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "license": "MIT"
}
