{
  "name": "dsh-subagent-qoder",
  "version": "0.1.1",
  "description": "One-shot Qoder subagent provider for DeepSeek Harness over the official Qoder Agent SDK",
  "type": "module",
  "license": "MIT",
  "author": "futuretea",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/futuretea/dsh-subagent-qoder.git"
  },
  "homepage": "https://github.com/futuretea/dsh-subagent-qoder#readme",
  "bugs": {
    "url": "https://github.com/futuretea/dsh-subagent-qoder/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "subagent",
    "qoder"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "test": "vitest run",
    "test:package": "node scripts/check-package.mjs",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --noEmit"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.0.1-rc.1 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.1.0 <5.0.0",
    "@deepseek-ai/dsh-llm": ">=0.0.1-rc.1 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.0.1-rc.1 <0.3.0",
    "@deepseek-ai/dsh-subagent": ">=0.0.1-rc.1 <0.3.0",
    "@deepseek-ai/dsh-subprocess": ">=0.0.1-rc.1 <0.3.0",
    "@deepseek-ai/dsh-timeout": ">=0.0.1-rc.1 <0.3.0",
    "@deepseek-ai/dsh-tool-subagent": ">=0.0.1-rc.1 <0.3.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0",
    "@qoder-ai/qoder-agent-sdk": "^1.0.59"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-app-boot": "0.2.2-rc.2",
    "@deepseek-ai/dsh-brand": "0.2.2-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.2",
    "@deepseek-ai/dsh-session": "0.2.2-rc.2",
    "@deepseek-ai/dsh-subagent": "0.2.2-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.2.2-rc.2",
    "@deepseek-ai/dsh-timeout": "0.2.2-rc.2",
    "@deepseek-ai/dsh-tool-subagent": "0.2.2-rc.2",
    "@types/node": "^22.20.1",
    "oxlint": "^1.93.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
